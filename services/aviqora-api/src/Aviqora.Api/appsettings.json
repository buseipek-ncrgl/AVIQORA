{
  "UseInMemoryDatabase": "true",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aviqora_db;Username=postgres;Password=postgres"
  },
  "ExternalApis": {
    "OpenAi": {
      "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
      "Model": "gpt-4o"
    },
    "GooglePlaces": {
      "ApiKey": "YOUR_GOOGLE_PLACES_API_KEY_HERE"
    },
    "Weather": {
      "Provider": "RapidAPI",
      "ApiKey": "YOUR_RAPIDAPI_KEY_HERE",
